# ── Airtable widget lock-contention retry ────────────────────────────
# Metric/Chart widgets have no live fallback, so a per-base lock loss to a
# sibling widget on the same base used to surface as `available=false` on the
# spot (the same component flipping false→value between adjacent calls).
# These "patient" callers now retry both the per-fingerprint and the per-base
# lock on the schedule below. All values are optional; the app falls back to
# these defaults when unset. Worst-case added wait is bounded by
# MAX_ATTEMPTS × (BASE_INTERVAL + jitter_max) — no separate total-wait cap.

# Shared by BOTH locks: how many times a patient caller retries, and the
# fixed base interval (seconds) between attempts.
AIRTABLE_CACHE_LOCK_RETRY_MAX_ATTEMPTS=5
AIRTABLE_CACHE_LOCK_RETRY_BASE_INTERVAL_SECONDS=2.0

# Per-base-lock jitter (seconds), added to the base interval each attempt.
AIRTABLE_CACHE_BASE_LOCK_JITTER_MIN_SECONDS=0.5
AIRTABLE_CACHE_BASE_LOCK_JITTER_MAX_SECONDS=2.0

# Fingerprint-lock jitter starts GAP seconds ABOVE the per-base jitter MAX and
# spans RANGE seconds, keeping every fingerprint-lock poll strictly longer than
# any base-lock retry so followers never give up while the lead is still
# mid-contention. Defaults => fingerprint jitter in [3.0, 5.0].
AIRTABLE_CACHE_FINGERPRINT_LOCK_JITTER_RANGE_SECONDS=2.0
AIRTABLE_CACHE_FINGERPRINT_LOCK_JITTER_GAP_SECONDS=1.0
